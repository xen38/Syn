{
  "name": "syn",
  "version": "1.0.0",
  "description": "Syn — a unified agent memory environment: search sessions + Memory Vault via the /locate engine and brainmaxxing console",
  "main": "dist/main.js",
  "scripts": {
    "start": "npx tsc && node scripts/copy-assets.mjs && electron .",
    "dev": "npx tsc && node scripts/copy-assets.mjs && electron .",
    "build": "electron-builder",
    "tsc": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts --max-warnings 0",
    "test": "node -e \"require('tsx'); process.exit(0)\" && tsx test/search.test.ts && tsx test/search-quality.test.ts && tsx test/validator-precision.test.ts && tsx test/fixture-tests.ts && tsx test/indexing.test.ts && tsx test/security.test.ts && tsx test/brainmaxxing.test.ts && tsx test/session-delete.test.ts && tsx test/g3-filter-forwarding.test.ts && tsx test/mcp.test.ts && tsx test/real-world-integration.test.ts"
  },
  "keywords": [
    "sessions",
    "search",
    "archive",
    "harness",
    "agent",
    "copilot",
    "mcp",
    "memory-vault",
    "brainmaxxing"
  ],
  "author": "xen38",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xen38/Syn.git"
  },
  "bugs": {
    "url": "https://github.com/xen38/Syn/issues"
  },
  "homepage": "https://github.com/xen38/Syn#readme",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.6.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0"
  },
  "build": {
    "appId": "com.xen38.syn",
    "productName": "Syn",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.iconset"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "sql.js": "^1.10.0",
    "ws": "^8.23.0"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "type": "commonjs"
}
