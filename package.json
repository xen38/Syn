{
  "name": "@xen38/syn-mcp",
  "version": "1.0.0",
  "description": "Syn — a unified agent memory environment: search sessions + Memory Vault via the /locate engine and brainmaxxing console",
  "main": "main.js",
  "bin": {
    "syn-mcp": "mcp-server.js"
  },
  "files": [
    "mcp-server.js",
    "main.js",
    "preload.js",
    "packages/",
    "renderer/",
    "brain/",
    "skills/",
    "test/"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "lint": "eslint . --ext .js --max-warnings 0",
    "test": "node test/search.test.js && node test/search-quality.test.js && node test/validator-precision.test.js && node test/fixture-tests.js && node test/indexing.test.js && node test/security.test.js && node test/real-world-integration.test.js"
  },
  "keywords": [
    "sessions",
    "search",
    "archive",
    "harness",
    "agent",
    "copilot",
    "mcp",
    "memory-vault",
    "brainmaxxing"
  ],
  "author": "xen38",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xen38/Syn.git"
  },
  "bugs": {
    "url": "https://github.com/xen38/Syn/issues"
  },
  "homepage": "https://github.com/xen38/Syn#readme",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.6.0"
  },
  "build": {
    "appId": "com.xen38.syn",
    "productName": "Syn",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.iconset"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "sql.js": "^1.10.0"
  }
}
